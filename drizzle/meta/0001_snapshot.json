        },
        "activities_start_date": {
          "name": "activities_start_date",
          "value": "\"activities\".\"start_date\" glob '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'"
        },
        "activities_end_date": {
          "name": "activities_end_date",
